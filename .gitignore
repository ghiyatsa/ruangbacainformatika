# Dependency Directories
/node_modules
/vendor

# Laravel & Vite Build / Cache Directories
/.phpunit.cache
/.phpunit.result.cache
/bootstrap/ssr
/public/build
/public/hot
/public/storage
# public/assets is the storage:link symlink target (see config/filesystems.php).
# Never track it: a tracked file inside this path makes git replace the symlink
# with a real directory on every pull/reset, breaking access to uploaded files.
/public/assets
/storage/*.key
/storage/pail

# Laravel Wayfinder Generated Files
/resources/js/actions
/resources/js/routes
/resources/js/wayfinder

# Environment & Authentication Configurations
.env
.env.backup
.env.production
.env.testing
.env.local
.env.*.local
/auth.json

# Local Development / Tooling Configurations
.codex/
.opencode/
*.stackdump
/storage/framework/lsp-*.php
.DS_Store
.phpactor.json
Homestead.json
Homestead.yaml
npm-debug.log
yarn-error.log
.eslintcache
*.tsbuildinfo
composer.phar

# Editor/IDE Folders
/.fleet
/.idea
/.nova
/.vscode
/.zed

# Project Scratch & TestSprite Temp Directories
