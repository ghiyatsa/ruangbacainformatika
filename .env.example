APP_NAME="Ruang Baca Informatika"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000
APP_GLOBAL_NOTICE_ENABLED=false
APP_GLOBAL_NOTICE_TEXT=
APP_GLOBAL_NOTICE_URL=
APP_GLOBAL_NOTICE_LINK_LABEL=
APP_GLOBAL_NOTICE_TONE=info

# Data akun super admin awal (dibuat oleh SuperAdminSeeder)
APP_SUPER_ADMIN_NAME=
APP_SUPER_ADMIN_EMAIL=
APP_SUPER_ADMIN_WHATSAPP=
APP_SUPER_ADMIN_ADDRESS=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

# Daftar proxy tepercaya (CDN/LB), dipisah koma: 1.2.3.4, 5.6.7.0/24
# Biarkan kosong jika aplikasi diakses langsung tanpa proxy.
TRUSTED_PROXIES=


BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ruangbaca_db
DB_USERNAME=root
DB_PASSWORD=

FONNTE_API_URL=
FONNTE_API_TOKEN=
FONNTE_SEND_INTERVAL_SECONDS=15
FONNTE_OTP_SEND_INTERVAL_SECONDS=5
FONNTE_FAILURE_PAUSE_THRESHOLD=5
FONNTE_FAILURE_PAUSE_WINDOW_MINUTES=15

SIMILARITY_API_URL=
SIMILARITY_API_SECRET=
HF_TOKEN=
SIMILARITY_API_TIMEOUT=10

# auto | force | off — kirim/ubah data skripsi ke API kemiripan
SIMILARITY_SYNC_DISPATCH=auto

TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# === PRODUCTION 2 (full Redis support) ===
# SESSION_DRIVER=redis
# SESSION_ENCRYPT=true
# ==========================================

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

# === PRODUCTION 2 (full Redis support) ===
# QUEUE_CONNECTION=redis
# CACHE_STORE=redis
# VITE_SSR=true
# ==========================================

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

RESEND_API_KEY=

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8000/auth/google/callback
KIOSK_DEFAULT_PIN=

VITE_APP_NAME="${APP_NAME}"
VITE_SSR=false

# SSR Inertia (server Node terpisah); sinkron dengan VITE_SSR
INERTIA_SSR_ENABLED=false

# Horizon (Production 2 only — requires Redis)
HORIZON_NAME="Ruang Baca"
